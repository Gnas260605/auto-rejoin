PORT=3000
NODE_ENV=development

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=auto_rejoin
DB_PASSWORD=change_me
DB_NAME=auto_rejoin_license

LICENSE_KEY_PEPPER=replace_with_32_plus_random_bytes
