# ==============================================================================
# Auto Rejoin Pro — Production Backend Environment Configuration Template
# ==============================================================================
# IMPORTANT: Generate all secrets using high-entropy random generation tools:
#   openssl rand -base64 32
#   -or-
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ==============================================================================

NODE_ENV=production
PORT=3000

# Reverse Proxy Trust (1 if behind Nginx/Caddy/Cloudflare to accurately read client IPs for rate-limiting)
TRUST_PROXY=1

# ── Production MySQL Database ──────────────────────────────────────────────────
# Do NOT use a test database (e.g. auto_rejoin_license_test) for production.
# Ensure MySQL is bound to 127.0.0.1 or an internal VPC network only.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=auto_rejoin_app
DB_PASSWORD=REPLACE_WITH_STRONG_GENERATED_PASSWORD_AT_LEAST_24_CHARS
DB_NAME=auto_rejoin_license

# ── Cryptographic Pepper for License Keys ──────────────────────────────────────
# NEVER lose or change this in production, otherwise existing active licenses
# cannot be validated. Must be at least 32 high-entropy random bytes.
LICENSE_KEY_PEPPER=REPLACE_WITH_OPENSSL_RAND_BASE64_32_PEPPER

# ── Client License Tokens ─────────────────────────────────────────────────────
LICENSE_TOKEN_TTL_SECONDS=2592000
LICENSE_REVALIDATE_AFTER_SECONDS=3600
MIN_CLIENT_VERSION=4.0.0

# ── Maintenance Mode ──────────────────────────────────────────────────────────
LICENSE_MAINTENANCE_MODE=false
LICENSE_MAINTENANCE_ALLOW_CACHE=true
LICENSE_MAINTENANCE_MESSAGE=Auto Rejoin License service is under maintenance. Please retry shortly.

# ── Administrative Authentication ─────────────────────────────────────────────
# Secret used for signing admin session JWTs. Must be at least 32 random characters.
ADMIN_JWT_SECRET=REPLACE_WITH_OPENSSL_RAND_BASE64_32_ADMIN_JWT_SECRET
ADMIN_TOKEN_TTL_SECONDS=86400

# Allowed Admin Dashboard Origin(s) for CORS. Exact origins only, never '*'.
# Example: https://admin.yourdomain.com or https://license.yourdomain.com
ADMIN_ORIGIN=https://admin.yourdomain.com

# Cookie Security (Must be true in production over HTTPS)
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_ACTIVATE_MAX=20
RATE_LIMIT_VALIDATE_MAX=120
RATE_LIMIT_DEACTIVATE_MAX=30
RATE_LIMIT_ADMIN_LOGIN_MAX=10
RATE_LIMIT_ADMIN_API_MAX=300
